---
import "../styles/global.css";

const title = "Neoplastic Scroll";
const description = "An endless De Stijl canvas. Scroll forever through generated Mondrian-style compositions.";
// Asset paths include the base path (/infinite-composition/ on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Social previews need an absolute image URL, built from `site` in astro.config.mjs.
const ogImage = Astro.site ? new URL(`${base}og.png`, Astro.site).href : `${base}og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#111111" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Neoplastic Scroll: a grid of red, blue and yellow Mondrian-style compositions" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="canvas">
      <!-- Masthead: itself a neoplastic grid -->
      <header class="row masthead" style="--h: clamp(280px, 52vh, 520px)">
        <div class="cell span-7 c-white title">
          <h1>NEO<br />PLAST<br />ICISM</h1>
        </div>
        <div class="cell span-2 c-red"></div>
        <div class="cell span-3 stack">
          <div class="c-white meta">
            <span class="label">De Stijl · Feed seed</span>
            <span class="seed-value" id="seed">—</span>
            <button type="button" class="text-button" id="copy-feed">Copy feed link</button>
          </div>
          <div class="c-blue"></div>
          <div class="c-white small-note">
            <span class="note-touch">Tap a work to open it. Swipe between works, tap again to recompose, and save the ones you like.</span>
            <span class="note-mouse">Click a work to recompose it. Point at a work and press <kbd>O</kbd> to open, <kbd>R</kbd> recompose, <kbd>S</kbd> save, <kbd>D</kbd> download or <kbd>L</kbd> copy a link. <kbd>←</kbd><kbd>↑</kbd><kbd>→</kbd><kbd>↓</kbd> move between works.</span>
          </div>
        </div>
      </header>

      <section id="feed" aria-label="Compositions"></section>

      <div id="sentinel" class="row loader" style="--h: 120px">
        <div class="cell span-12 c-white loader-cell">
          <span class="dot c-red"></span>
          <span class="dot c-yellow"></span>
          <span class="dot c-blue"></span>
        </div>
      </div>
    </main>

    <div class="dock">
      <button type="button" class="saved-button" id="open-saved" title="Saved works">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13.5 2.6 8.1a3.1 3.1 0 0 1 4.4-4.4L8 4.7l1-1a3.1 3.1 0 0 1 4.4 4.4Z" /></svg>
        <span id="saved-count">0</span>
      </button>
      <aside class="counter" aria-label="Works generated so far" title="Works generated so far">
        <span class="counter-label">Works</span>
        <span id="count">0</span>
      </aside>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import { initFeed } from "../scripts/feed";
      initFeed();
    </script>
  </body>
</html>
